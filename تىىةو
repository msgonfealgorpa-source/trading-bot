            for col in ['open','high','low','close','volume']:
                df[col] = pd.to_numeric(df[col], errors='coerce')
            return df
        return None

    # ═════════════════════ تحليل صيد الحيتان (Multi-TF + ATR + Stochastic) ═════════════════════
    async def analyze_whale_zone(self, symbol):
        # ═══ سر القناص: دمج 3 فريمات (4H للاتجاه، 1H للمناطق، 15M للزناد) ═══
        df_4h = await self.get_klines(symbol, '4h', 100)   # فريم 4 ساعات لتحديد الاتجاه العام (الماكرو)
        df_1h = await self.get_klines(symbol, '1h', 100)   # فريم الساعة لرسم خريطة الحيتان (Order Blocks)
        df_15m = await self.get_klines(symbol, '15m', 100) # فريم 15 دقيقة لاستخراج زناد الدخول الفعلي
        
        if df_4h is None or len(df_4h) < 30 or df_1h is None or len(df_1h) < 30 or df_15m is None or len(df_15m) < 30: 
            return None

        prices = self.get_price(symbol)  # ✅ سعر طازج فقط
        if not prices: return None

        current_price = prices['ask']

        # 1. نحدد الاتجاه من فريم الـ 4 ساعات (الاتجاه الماكرو الحقيقي)
        ema50_4h = df_4h['close'].ewm(span=50, adjust=False).mean().iloc[-1]
        trend = 'BUY' if current_price > ema50_4h else 'SELL'

        # 2. نرسم مناطق العرض والطلب من فريم الساعة (مناطق الحيتان الكبرى)
        obs = self.smc.detect_order_blocks(df_1h, trend)
        if not obs: return None

        # 3. هل السعر قريب من منطقة الحوت؟
        nearby_ob = None
        for ob in reversed(obs):
            if trend == 'BUY' and ob['type'] == 'demand':
                distance_pct = (current_price - ob['top']) / current_price
                if 0 <= distance_pct <= 0.02: # مسافة 2% لفريم الساعة
                    nearby_ob = ob
                    break
            elif trend == 'SELL' and ob['type'] == 'supply':
                distance_pct = (ob['bottom'] - current_price) / current_price
                if 0 <= distance_pct <= 0.02:
                    nearby_ob = ob
                    break

        if not nearby_ob: return None

        # 4. نبحث عن تصفية السيولة (Sweep) من فريم 15 دقيقة (الزناد السريع)
        is_sweep = self.smc.detect_liquidity_sweep(df_15m, nearby_ob, trend)
        if not is_sweep: return None

        # 5. التأكيد النهائي بكروس الاستوكاستيك على فريم 15 دقيقة
        df_15m = self.smc.calculate_stochastic(df_15m)
        
        # ✅ الكروس يُقاس على الشموع المغلقة فقط (منع Repainting)
        current_k = df_15m['stoch_k'].iloc[-2]
        prev_k = df_15m['stoch_k'].iloc[-3]
        current_d = df_15m['stoch_d'].iloc[-2]
        prev_d = df_15m['stoch_d'].iloc[-3]
        
        stoch_confirmed = False
        if trend == 'BUY':
            # كروس صعودي في منطقة التشبع البيعي (أقل من 20)
            if current_k > current_d and prev_k <= prev_d and current_k < 20:
                stoch_confirmed = True
        elif trend == 'SELL':
            # كروس هبوطي في منطقة التشبع الشرائي (أعلى من 80)
            if current_k < current_d and prev_k >= prev_d and current_k > 80:
                stoch_confirmed = True
                
        if not stoch_confirmed: return None

        # ═══ 6. حساب الدخول والأهداف (باستخدام ATR لمواجهة التقلب العنيف) ═══
        entry_price = current_price
        
        # حساب ATR لمعرفة متوسط تقلب العملة من فريم 15 دقيقة
        df_15m['high_low'] = df_15m['high'] - df_15m['low']
        df_15m['high_close'] = abs(df_15m['high'] - df_15m['close'].shift())
        df_15m['low_close'] = abs(df_15m['low'] - df_15m['close'].shift())
        df_15m['tr'] = df_15m[['high_low', 'high_close', 'low_close']].max(axis=1)
        atr = df_15m['tr'].rolling(14).mean().iloc[-1]
        
        # الوقف يجب أن يكون 2 ضعف الـ ATR ليتجاوز ذيول الحيتان (Wicks)
        sl_buffer = atr * 2.0 
        
        if trend == 'BUY':
            sl = nearby_ob['bottom'] - sl_buffer # وقف الخسارة تحت المنطقة بمسافة آمنة
            tp1 = entry_price + (atr * 1.5)      # الهدف الأول 1.5 ضعف التقلب (Hit & Run)
            tp2 = entry_price + (atr * 4.0)      # الهدف الثاني للمتابعة
        else:
            sl = nearby_ob['top'] + sl_buffer
            tp1 = entry_price - (atr * 1.5)
            tp2 = entry_price - (atr * 4.0)

        # تحقق ألا تكون نسبة المخاطرة أكبر من المتوقع
        risk_pct = abs(entry_price - sl) / entry_price * 100
        if risk_pct > 3.0: # إذا كان الوقف يطلب خسارة أكثر من 3% (30% من الهامش مع رافعة 10x)، ارفض الصفقة
            return None

        return {
            'symbol': symbol, 'direction': trend, 'price': entry_price,
            'sl': sl, 'tp1': tp1, 'tp2': tp2, 'score': 10,
            'signals_smc': [f"🐋 صيد حوت في منطقة {'طلب' if trend=='BUY' else 'عرض'}", 
                           "⚡ تصفية سيولة (فخ للضعفاء)",
                           f"📈 كروس استوكاستك مؤكد على 15M",
                           f"🛡️ وقف واسع ({risk_pct:.1f}%) لتجنب الذيل"]
        }

    # ═════════════════════ التداول للعقود الآجلة ═════════════════════
    async def execute_trade(self, analysis):
        if not self.TRADE_ENABLED: return
        if len(self.active_trades) >= self.MAX_OPEN_TRADES: return

        symbol = analysis['symbol']
        if symbol in self.active_trades: return
        if self.is_in_cooldown(symbol): return  # ✅ كولداون بعد الإغلاق

        # ✅ V7.4: الهامش 10$ × رافعة 10x = قيمة الدخول (نوشنال) 100$         notional = self.TRADE_SIZE_USDT * self.LEVERAGE
        quantity = self.format_quantity(symbol, notional / analysis['price'])
        if quantity <= 0: return

        # ✅ فحص الحد الأدنى للكمية والنوشنال قبل إرسال أمر محكوم بالرفض
        # (هامش أمان 2%: زوج حدّه الأدنى 100$ مثل BTC لن يقبل نوشنال 100$ بالضبط)
        if quantity < self.min_qty_cache.get(symbol, 0.0): return
        if quantity * analysis['price'] < self.min_notional_cache.get(symbol, 5.0) * 1.02:
            logger.info(f"⏭️ تخطي {symbol}: النوشنال أقل من الحد الأدنى للزوج")
            return

        # ✅ ضبط الرافعة والهامش لهذا الزوج تحديداً قبل الدخول (ليس أول 50 فقط)
        await self._fapi_request('POST', '/fapi/v1/leverage',
            {'symbol': symbol, 'leverage': self.LEVERAGE}, signed=True)
        await self._fapi_request('POST', '/fapi/v1/marginType',
            {'symbol': symbol, 'marginType': 'ISOLATED'}, signed=True)

        side = 'BUY' if analysis['direction'] == 'BUY' else 'SELL'

        result = await self._fapi_request('POST', '/fapi/v1/order', {
            'symbol': symbol, 'side': side, 'type': 'MARKET',
            'quantity': self.qty_to_str(symbol, quantity)
        }, signed=True)

        if not result or result.get('status') not in ['FILLED', 'NEW']:
            await self.tg(f"❌ *فشل تنفيذ {side} (`{symbol}`)*\n⚠️ تأكد من إعدادات العقود الآجلة")
            return

        # ✅ avgPrice قد يعود "0" عندما يكون الstatus=NEW
        avg = float(result.get('avgPrice') or 0)
        entry_price = avg if avg > 0 else analysis['price']
        
        trade_data = {
            'symbol': symbol, 'side': side, 'entry_price': entry_price,
            'quantity': quantity, 'sl': analysis['sl'], 'tp': analysis['tp1'],
            'trailing_active': False, 'highest_price': entry_price,
            'lowest_price': entry_price, 'entry_time': time.time(),
            'partial_closed': False, 'realized_pnl': 0.0,
            'stop_order_id': None, 'stop_synced_price': None
        }
        self.active_trades[symbol] = trade_data
        await self.db.save_trade(trade_data)
        self.stats['trades_executed'] += 1

        # ✅ ستوب أمان حقيقي على المنصة فوراً (يحمي المركز لو انقطع البوت)
        prices = self.get_price(symbol)
        ref_price = (prices['bid'] if side == 'BUY' else prices['ask']) if prices else entry_price
        await self._sync_stop_order(trade_data, ref_price)
        await self.db.save_trade(trade_data)  # حفظ رقم أمر الستوب

        msg = (f"✅ *صفقة عقود آجلة منفذة!*\n━━━━━━━━━━━━━━━━━━━━━━━━\n"
               f"🪙 الزوج: `{symbol}` | الرافعة: 10x\n"
               f"💵 الدخول: {self.fmt_price(entry_price)}\n"
               f"💰 القيمة: 100$ (هامش 10$)\n"
               f"🛑 وقف الخسارة: {self.fmt_price(analysis['sl'])}\n"
               f"🎯 هدف 1 (Hit & Run): {self.fmt_price(analysis['tp1'])}\n"
               f"🚀 هدف 2 (متابعة): {self.fmt_price(analysis['tp2'])}\n"
               f"🛡️ ستوب أمان على المنصة: {'✅ مفعّل' if trade_data['stop_order_id'] else '⏳ قيد التفعيل'}\n"
               f"🐋 الاستراتيجية: {'طلب حوتي' if side=='BUY' else 'عرض حوتي'} + تصفية سيولة + كروس استوكاستك")
        await self.tg(msg)

    # ═══ مزامنة ستوب المنصة مع الوقف المحلي (تعادل + متحرك) ═══
    async def _sync_stop_order(self, trade, current_price):
        """
        يضمن وجود أمر STOP_MARKET (closePosition) على المنصة مطابق لمستوى SL المحلي.
        يُستدعى بعد الدخول، وبعد الجني الجزئي، وعند كل تحرك للوقف المتحرك.
        """
        symbol = trade['symbol']
        is_buy = trade['side'] == 'BUY'
        desired = trade['sl']
        if desired is None: return False

        # لا تضع ستوباً في الجهة الخاطئة (سينفّذ فوراً) — الإغلاق المحلي سيتكفل به
        if current_price and ((is_buy and desired >= current_price) or (not is_buy and desired <= current_price)):
            return False

        # الستوب الموجود مطابق بالفعل؟ لا حاجة لأي طلب API
        if trade.get('stop_order_id') and trade.get('stop_synced_price') is not None:
            if abs(trade['stop_synced_price'] - desired) < 1e-12:
                return False

        # إلغاء الستوب القديم إن وجد
        if trade.get('stop_order_id'):
            await self._fapi_request('DELETE', '/fapi/v1/order',
                {'symbol': symbol, 'orderId': trade['stop_order_id']}, signed=True)
            trade['stop_order_id'] = None
            trade['stop_synced_price'] = None

        stop_side = 'SELL' if is_buy else 'BUY'
        res = await self._fapi_request('POST', '/fapi/v1/order', {
            'symbol': symbol, 'side': stop_side, 'type': 'STOP_MARKET',
            'stopPrice': self.price_to_str(symbol, desired),
            'closePosition': 'true'
        }, signed=True)

        if res and res.get('orderId'):
            trade['stop_order_id'] = res['orderId']
            trade['stop_synced_price'] = desired
            return True
        logger.warning(f"⚠️ تعذّر تحديث ستوب المنصة لـ {symbol} — ستتم إعادة المحاولة")
        return False

    # ═══ استعلامات المنصة (مصادقة المراكز والأرباح المحققة) ═══
    async def get_position_amt(self, symbol):
        """كمية المركز الفعلية على المنصة (None = فشل الطلب)"""
        try:
            res = await self._fapi_request('GET', '/fapi/v2/positionRisk',
                {'symbol': symbol}, signed=True)
            if isinstance(res, list) and res:
                return float(res[0].get('positionAmt', 0))
        except: pass
        return None

    async def get_last_realized_pnl(self, symbol, trade):
        """آخر ربح/خسارة محققة للزوج من سجل الدخل (دقيق عند تنفيذ الستوب على المنصة)"""
        try:
            res = await self._fapi_request('GET', '/fapi/v1/income',
                {'symbol': symbol, 'incomeType': 'REALIZED_PNL', 'limit': 20}, signed=True)
            if isinstance(res, list) and res:
                entry_ms = int(trade.get('entry_time', 0) * 1000)
                last = None
                for e in res:
                    if int(e.get('time', 0)) >= entry_ms - 5000:
                        last = e
                if last is not None:
                    return float(last.get('income', 0))
        except: pass
        return None

    async def verify_positions(self):
        """
        ✅ مصادقة المراكز المتتبعة مع الوضع الفعلي على المنصة.
        تلتقط الحالة التي نفّذ فيها ستوب المنصة بين دورتين (أو أثناء توقف البوت)
        حتى لا تبقى صفقة وهمية في التتبع.
        """
        if not self.active_trades: return
        for symbol, trade in list(self.active_trades.items()):
            try:
                amt = await self.get_position_amt(symbol)
                if amt is None: continue
                step = self.step_sizes_cache.get(symbol) or 1.0
                if abs(amt) < step:  # المركز مغلق على المنصة والبوت لم يلحظ
                    pnl = await self.get_last_realized_pnl(symbol, trade)
                    prices = self.get_price(symbol)
                    if prices:
                        px = prices['bid'] if trade['side'] == 'BUY' else prices['ask']
                    else:
                        px = trade['entry_price']
                    await self._finalize_trade(trade, px, "🛑 أُغلق على المنصة (Stop-Loss)", pnl)
            except Exception as e:
                logger.warning(f"⚠️ فشل التحقق من مركز {symbol}: {e}")

    # ═══ إغلاق آمن للمركز ═══
    async def _close_position(self, trade, current_price):
        """
        يُغلق المركز بأمر reduceOnly (يستحيل أن يفتح مركزاً معاكساً بالخطأ).
        يعيد (نجح؟, سعر التنفيذ, ربح بديل من سجل المنصة إن أُغلق المركز خارجياً)
        ✅ لا يحذف الصفقة من التتبع عند الفشل — يعيد المحاولة في الدورة القادمة.
        """
        symbol = trade['symbol']
        is_buy = trade['side'] == 'BUY'
        close_side = 'SELL' if is_buy else 'BUY'

        res = await self._fapi_request('POST', '/fapi/v1/order', {
            'symbol': symbol, 'side': close_side, 'type': 'MARKET',
            'quantity': self.qty_to_str(symbol, trade['quantity']),
            'reduceOnly': 'true'
        }, signed=True)

        if res and res.get('status') in ['FILLED', 'NEW']:
            fill = float(res.get('avgPrice') or 0)
            fill_price = fill if fill > 0 else current_price
            return True, fill_price, None

        # فشل الأمر — هل المركز أُغلق خارجياً (ستوب المنصة نفّذ أولاً)؟
        amt = await self.get_position_amt(symbol)
        if amt is not None:
            step = self.step_sizes_cache.get(symbol) or 1.0
            if abs(amt) < step:
                pnl = await self.get_last_realized_pnl(symbol, trade)
                return True, current_price, pnl

        logger.error(f"⚠️ فشل إغلاق {symbol} — ستعاد المحاولة في الدورة القادمة")
        return False, None, None

    # ═══ إنهاء الصفقة (محاسبة كاملة) ═══
    async def _finalize_trade(self, trade, fill_price, reason, pnl_override=None):
        symbol = trade['symbol']
        is_buy = trade['side'] == 'BUY'

        # إلغاء ستوب المنصة المتبقي (إن لم يكن قد نُفّذ بالفعل)
        if trade.get('stop_order_id'):
            await self._fapi_request('DELETE', '/fapi/v1/order',
                {'symbol': symbol, 'orderId': trade['stop_order_id']}, signed=True)

        if pnl_override is not None:
            final_pnl = pnl_override
        else:
            if is_buy: final_pnl = (fill_price - trade['entry_price']) * trade['quantity']
            else: final_pnl = (trade['entry_price'] - fill_price) * trade['quantity']

        # ✅ النتيجة الإجمالية تشمل ربح الجني الجزئي
        total_pnl = trade.get('realized_pnl', 0.0) + final_pnl

        # ✅ V7.4: النسبة تُحسب من الهامش الفعلي (10$) — والنوشنال 100$         margin_used = self.TRADE_SIZE_USDT
        margin_pnl_pct = (total_pnl / margin_used * 100) if margin_used > 0 else 0

        is_win = total_pnl > 0
        if is_win: self.stats['wins'] += 1
        else: self.stats['losses'] += 1

        await self.db.update_daily_pnl(total_pnl, is_win)
        await self.db.remove_trade(symbol)
        self.active_trades.pop(symbol, None)
        self.set_cooldown(symbol)  # ✅ كولداون 15 دقيقة

        icon = "✅" if is_win else "❌"
        partial_note = (f"\n🧾 ربح الجني الجزئي المحقق مسبقاً: `{trade.get('realized_pnl', 0.0):.4f} USDT`"
                        if abs(trade.get('realized_pnl', 0.0)) > 1e-9 else "")
        msg = (f"🏁 {icon} *إغلاق `{symbol}`*\n━━━━━━━━━━━━━━━━━━━━━━━━\n"
               f"{reason}\n"
               f"💵 النتيجة الإجمالية: `{total_pnl:.4f} USDT` ({margin_pnl_pct:.1f}% من الهامش)\n"
               f"🏆 الإجمالي: {self.stats['wins']}W / {self.stats['losses']}L{partial_note}")
        await self.tg(msg)

    # ═════════════════════ مراقبة الصفقات (Hit & Run) ═════════════════════
    async def monitor_trades(self):
        if not self.active_trades: return

        stale_symbols = []
        for symbol, trade in list(self.active_trades.items()):
            prices = self.get_price(symbol)
            if not prices:
                stale_symbols.append(symbol)  # سعر مجمّد — ستوب المنصة يحمي المركز
                continue

            is_buy = trade['side'] == 'BUY'
            current_price = prices['bid'] if is_buy else prices['ask']
            changed = False

            # تحديث القمة/القاع (للوقف المتحرك)
            if is_buy and current_price > trade.get('highest_price', 0):
                trade['highest_price'] = current_price; changed = True
            elif not is_buy and current_price < trade.get('lowest_price', 999999):
                trade['lowest_price'] = current_price; changed = True

            # 1) فحص وقف الخسارة
            if (is_buy and current_price <= trade['sl']) or (not is_buy and current_price >= trade['sl']):
                closed, fill_price, pnl_override = await self._close_position(trade, current_price)
                if closed:
                    await self._finalize_trade(trade, fill_price, "🛑 ضرب SL", pnl_override)
                continue  # إن فشل الإغلاق تُعاد المحاولة في الدورة القادمة

            # 2) جني أرباح جزئي عند TP1 (Hit & Run: 90% فوري)
            if not trade.get('partial_closed', False) and trade.get('tp'):
                if (is_buy and current_price >= trade['tp']) or (not is_buy and current_price <= trade['tp']):
                    partial_qty = self.format_quantity(symbol, trade['quantity'] * 0.9)
                    remaining_qty = self.format_quantity(symbol, trade['quantity'] - partial_qty)
                    min_notional = self.min_notional_cache.get(symbol, 5.0)

                    # ✅ V7.4: لو حدود الزوج لا تسمح بتجزئة 90/10
                    # (مثل ETH حده 20$ والمتبقي 10$) → إغلاق كامل 100% بدل التجزئة المستحيلة
                    if (partial_qty <= 0 or remaining_qty <= 0
                            or partial_qty * current_price < min_notional
                            or remaining_qty * current_price < min_notional):
                        closed, fill_price, pnl_override = await self._close_position(trade, current_price)
                        if closed:
                            await self._finalize_trade(trade, fill_price, "🎯 هدف TP1 (إغلاق كامل — حدود الزوج)", pnl_override)
                        continue

                    close_side = 'SELL' if is_buy else 'BUY'
                    res = await self._fapi_request('POST', '/fapi/v1/order', {
                        'symbol': symbol, 'side': close_side, 'type': 'MARKET',
                        'quantity': self.qty_to_str(symbol, partial_qty),
                        'reduceOnly': 'true'
                    }, signed=True)

                    if res and res.get('status') in ['FILLED', 'NEW']:
                        fill = float(res.get('avgPrice') or 0)
                        fill_price = fill if fill > 0 else current_price
                        if is_buy: partial_pnl = (fill_price - trade['entry_price']) * partial_qty
                        else: partial_pnl = (trade['entry_price'] - fill_price) * partial_qty

                        trade['realized_pnl'] = trade.get('realized_pnl', 0.0) + partial_pnl
                        await self.db.update_daily_pnl(partial_pnl, None)

                        # ✅ الكمية المتبقية منسّقة على خطوة الزوج (محسوبة سابقاً بنفس الكمية)
                        trade['quantity'] = remaining_qty
                        trade['partial_closed'] = True
                        # ✅ تعادل يغطي العمولات والتمويل (0.3% بدل 0.1% الوهمية)
                        trade['sl'] = trade['entry_price'] * 1.003 if is_buy else trade['entry_price'] * 0.997
                        changed = True
                        await self.tg(f"🎯 *جني أرباح أول (`{symbol}`)*\n"
                                      f"💸 تم إغلاق 90% بربح: `{partial_pnl:.4f} USDT`\n"
                                      f"🛡️ الوقف الآن على التعادل (+0.3% لتغطية العمولات)")
                    else:
                        # فشل الجزئي — تحقق إن كان المركز أُغلق خارجياً (ستوب المنصة)
                        amt = await self.get_position_amt(symbol)
                        if amt is not None and abs(amt) < (self.step_sizes_cache.get(symbol) or 1.0):
                            pnl = await self.get_last_realized_pnl(symbol, trade)
                            await self._finalize_trade(trade, current_price, "🛑 أُغلق على المنصة (Stop)", pnl)
                            continue
                        logger.warning(f"⚠️ فشل الجني الجزئي لـ {symbol} — إعادة المحاولة")

            # 3) الوقف المتحرك (بعد الجني الجزئي) — 1% من القمة/القاع كما في التصميم
            if trade.get('partial_closed'):
                if is_buy:
                    new_sl = trade['highest_price'] * 0.99
                    if new_sl > trade['sl']:
                        trade['sl'] = new_sl; changed = True
                else:
                    new_sl = trade['lowest_price'] * 1.01
                    if new_sl < trade['sl']:
                        trade['sl'] = new_sl; changed = True

            # 4) مزامنة ستوب المنصة مع المستوى المحلي الجديد
            if await self._sync_stop_order(trade, current_price):
                changed = True

            # ✅ حفظ كل تغيير (وقف متحرك/قمم/كمية) حتى لا يضيع بعد إعادة التشغيل
            if changed:
                await self.db.save_trade(trade)

        if stale_symbols:
            logger.warning(f"⚠️ أسعار WebSocket قديمة/غير متاحة: {stale_symbols} — ستوب المنصة يحمي هذه المراكز")

    # ═════════════════════ المسح السريع للمتقلبات (ديناميكي 100%) ═════════════════════
    async def scan_volatile_coins(self):
        tickers = await self._fapi_request('GET', '/fapi/v1/ticker/24hr')
        if not tickers: return

        targets = []
        for t in tickers:
            symbol = t.get('symbol', '')
            change = abs(float(t.get('priceChangePercent', 0)))
            if change > 5 and symbol in self.step_sizes_cache:
                targets.append({'symbol': symbol, 'change': change})

        targets.sort(key=lambda x: x['change'], reverse=True)

        results = []
        for target in targets[:20]: # نأخذ أعلى 20 عملة متقلبة حياً بدون أي تدخل يدوي
            symbol = target['symbol']
            if symbol in self.active_trades: continue
            if self.is_in_cooldown(symbol): continue  # ✅ لا إعادة دخول على نفس شمعة الإشارة

            analysis = await self.analyze_whale_zone(symbol)
            if analysis:
                results.append(analysis)
            await asyncio.sleep(0.5)

        if results:
            msg = "🚀 *مناطق حيتان مكتشفة!*\n━━━━━━━━━━━━━━━━━━━━━━━━\n"
            for a in results:
                msg += (f"🐋 `{a['symbol']}` | اتجاه: *{a['direction']}*\n"
                       f"💵 {self.fmt_price(a['price'])} | SL: {self.fmt_price(a['sl'])}\n")
            await self.tg(msg)

            for a in results:
                await self.execute_trade(a)
                await asyncio.sleep(1)

    # ═════════════════════ اللوب الرئيسي ═════════════════════
    async def main_loop(self):
        self.session = aiohttp.ClientSession()
        await self.db.init_db()
        await self.load_market_data()
        self.active_trades = await self.db.load_active_trades()
        
        # ✅ حماية: البوت مصمم لوضع One-way — لو الحساب Hedge Mode نتحول للمراقبة فقط
        try:
            dual = await self._fapi_request('GET', '/fapi/v1/positionSide/dual', signed=True)
            if dual and dual.get('dualSidePosition'):
                if self.TRADE_ENABLED:
                    self.TRADE_ENABLED = False
                    logger.error("❌ الحساب في وضع Hedge Mode — التحويل للمراقبة فقط (البوت يعمل بوضع One-way)")
                    await self.tg("⚠️ *تنبيه:* الحساب في وضع Hedge Mode. البوت مصمم لوضع One-way فقط — تم التحويل للمراقبة.")
        except: pass
        
        await self.setup_futures_account()
        
        # ✅ الاحتفاظ بمرجع للمهمة (حماية من garbage collection)
        self.ws_task = asyncio.create_task(self.ws_manager())
        await asyncio.sleep(10)

        # ✅ مصالحة بعد إعادة التشغيل — أي مركز أُغلق على المنصة أثناء التوقف؟
        await self.verify_positions()

        mode_trade = "⚔️ تداول عقود آجلة تلقائي" if self.TRADE_ENABLED else "👁️ مراقبة فقط"

        msg = ("🔥 *القناص الأسطوري V7.4 — صياد الحيتان!*\n━━━━━━━━━━━━━━━━━━━━━━━━\n"
               f"📡 الوضع: {mode_trade}\n"
               f"⚡ الرافعة: 10x | الهامش: معزول (Isolated)\n"
               f"💰 هامش الصفقة: 10$ × رافعة 10x = قيمة دخول 100$\n"
               f"🎯 استراتيجية: اتجاه ماكرو (4H) + عرض وطلب (1H) + تصفية سيولة وكروس استوكاستيك (15M)\n"
               f"🛡️ حماية: وقف ATR ذكي + ستوب مزدوج (محلي + على المنصة)\n"
               f"🏃 خطة خروج: Hit & Run (90% ربح سريع + 10% وقف متحرك)\n"
               "━━━━━━━━━━━━━━━━━━━━━━━━\n⏰ بدء المسح المتقلب الديناميكي...")
        await self.tg(msg)

        loop_count = 0
        try:
            while True:
                try:
                    await self.monitor_trades()
                    await self.scan_volatile_coins()
                    loop_count += 1
                    # ✅ مصادقة دورية مع المنصة (تلتقط ستوباً نفّذ بين الدورات)
                    if loop_count % self.VERIFY_EVERY_N_LOOPS == 0:
                        await self.verify_positions()
                    await asyncio.sleep(60) # فحص السوق كل 60 ثانية كحد أقصى لتوافق مع إغلاق شموع 15M
                except Exception as loop_err:
                    logger.error(f"خطأ في الحلقة: {loop_err}")
                    await asyncio.sleep(15)
        finally:
            await self.session.close()

    def start(self):
        asyncio.run(self.main_loop())

